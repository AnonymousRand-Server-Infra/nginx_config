PATH_TO_ROOT_DOCKER_PROJ=../../
PATH_FROM_ROOT_TO_UTILS=utils/
PATH_FROM_ROOT_TO_NGINX=proxy/nginx/

# note: if there are multiple space-separated pieces here, this `.env` file cannot be sourced
# in a script without `set +x`
NGINX_CONFIG_SRC_FILES=proxy/nginx/data/* proxy/anubis/nginx/data/* proxy/iocaine/nginx/data/* services/personal_website/deployment/nginx/data/* services/git_server/deployment/nginx/data/* services/mail_server/deployment/nginx/data/*
NGINX_ACME_CHALLS_PATH=/var/www/certbot/

# `.env` files needed for `envsubst` of config files
ENVSUBST_ENV_FILE_1=../iocaine/.env
ENVSUBST_ENV_FILE_2=../../services/personal_website/.env
ENVSUBST_ENV_FILE_3=../../services/personal_website/deployment/anubis/.env
ENVSUBST_ENV_FILE_5=../../services/git_server/.env
ENVSUBST_ENV_FILE_6=../../services/git_server/deployment/anubis/.env
ENVSUBST_ENV_FILE_7=../../services/mail_server/.env
ENVSUBST_ENV_FILE_8=../../services/mail_server/deployment/anubis/.env
